@echo off
title TITO Load Tester v2.0
color 0A
cd /d "%~dp0"

where python >nul 2>nul
if errorlevel 1 (
    echo [ERRO] Python nao encontrado. Instale em https://www.python.org/downloads/
    echo        Marque a opcao "Add Python to PATH" na instalacao.
    pause
    exit /b 1
)

python tito.py
if errorlevel 1 (
    echo.
    echo [ERRO] Falha ao executar o script.
    pause
)
